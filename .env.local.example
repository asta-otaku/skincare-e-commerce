# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key — server-side only, NEVER expose to the browser
# Required for admin operations that bypass RLS (e.g. user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payment (Week 2) ─────────────────────────────────────────────────────────
# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxx

# Flutterwave (optional alternative)
FLW_SECRET_KEY=FLWSECK_TEST-xxxx
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxx

# ─── Email / Newsletter (Week 3) ──────────────────────────────────────────────
RESEND_API_KEY=re_xxxx
NEXT_PUBLIC_MAILCHIMP_SUBSCRIBE_URL=https://us1.list-manage.com/subscribe/post?u=xxx&id=xxx
